{%- comment -%}
  样式微调，确保页面布局与集合页面一致
{%- endcomment -%}
<style>
/* 确保页面容器有适当的间距 */
.page-width {
  margin: 0 auto;
  padding: 0 1.5rem;
  max-width: 120rem;
}

/* 确保产品网格在不同屏幕尺寸下正确显示 */
.product-grid {
  margin-bottom: 5rem;
}

/* 优化4列布局的间距 */
.grid--4-col-desktop .grid__item {
  padding: 0 0.75rem;
  margin-bottom: 3rem;
}

/* 平板端3列布局优化 */
@media screen and (min-width: 750px) and (max-width: 989px) {
  .grid--3-col-tablet .grid__item {
    padding: 0 1rem;
    margin-bottom: 2.5rem;
  }
}

/* 隐藏状态的平滑过渡 */
#usmama-content,
#usmama-access-denied {
  transition: opacity 0.3s ease-in-out;
}

/* 访问拒绝页面的样式调整 */
#usmama-access-denied .collection--empty {
  min-height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 确保产品计数样式正确 */
.collection-product-count {
  text-align: center;
  margin-top: 2rem;
  color: rgba(var(--color-foreground), 0.75);
}

/* 响应式调整 */
@media screen and (max-width: 749px) {
  .product-grid {
    margin-bottom: 3rem;
  }
}
</style>
