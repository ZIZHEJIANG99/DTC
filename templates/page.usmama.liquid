{% comment %}
  USMAMA 隐藏页面模板
  用于展示 USMAMA 品牌的指定产品
  需要通过 URL 参数 key 进行访问控制
{% endcomment %}

{%- comment -%}
  引入必要的样式文件，保持与集合页面一致的外观
{%- endcomment -%}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  获取所有 USMAMA 产品
  包含 C-Panty、Post Baby Panty、Shrinkx、Stomach Settle 和 Milkflow 系列
{%- endcomment -%}
{%- liquid
  
  assign cpanty = all_products['cpanty-highwaist']
  assign cpanty_2pack = all_products['cpanty-highwaist-2pack']

  
  assign post_baby_panty = all_products['afterbabypanty-postpartum-underwear']
  assign post_baby_panty_2pack = all_products['post-baby-panty-2-pack']

  
  assign shrinkx_charcoal = all_products['shrinkxbelly-bamboo-charcoal']
  assign shrinkx_postpartum = all_products['shrinkxbelly-postpartum-belly-wrap']
  assign shrinkx_postpartum_2pack = all_products['shrinkx-belly-postpartum-belly-wrap-2-pack']

  
  assign stomach_settle = all_products['stomach-settle-nausea-relief-drops-mint']
  assign milkflow_drink = all_products['milkflow®-immune-support-drink-mix-orange-mango-16-ct']
  assign milkflow_chews = all_products['milkflow®-breastfeeding-soft-chew-berry-flavor-28-ct']
-%}

<div class="page-width">
  {%- comment -%}
    页面标题区域
  {%- endcomment -%}
  <header class="section-header text-center">
    <h1 class="section-header__title">
      {{ page.title | default: "USMAMA Products" }}
    </h1>
    {%- if page.content != blank -%}
      <div class="rte">
        {{ page.content }}
      </div>
    {%- endif -%}
  </header>

  {%- comment -%}
    隐藏的产品内容容器
    默认隐藏，只有通过密钥验证后才显示
  {%- endcomment -%}
  <div id="usmama-content" style="display: none;">
    <div class="collection collection-template">
      
      {%- comment -%}
        检查是否有可用的产品
      {%- endcomment -%}
      {%- assign available_products = 0 -%}
      {%- if cpanty -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if cpanty_2pack -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if post_baby_panty -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if post_baby_panty_2pack -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if shrinkx_charcoal -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if shrinkx_postpartum -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if shrinkx_postpartum_2pack -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if stomach_settle -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if milkflow_drink -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}
      {%- if milkflow_chews -%}
        {%- assign available_products = available_products | plus: 1 -%}
      {%- endif -%}

      {%- if available_products > 0 -%}
        {%- comment -%}
          产品网格容器 - 显示所有 USMAMA 产品
          采用响应式网格布局
        {%- endcomment -%}
        <ul id="product-grid"
            class="grid product-grid grid--4-col-desktop grid--3-col-tablet grid--2-col-tablet-down grid--1-col-mobile"
            role="list">

          {%- comment -%}
            循环渲染所有产品
          {%- endcomment -%}
          {%- assign product_count = 0 -%}

          {%- if cpanty -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: cpanty,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-cpanty',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if cpanty_2pack -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: cpanty_2pack,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-cpanty-2pack',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if post_baby_panty -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: post_baby_panty,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-post-baby-panty',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if post_baby_panty_2pack -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: post_baby_panty_2pack,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-post-baby-panty-2pack',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if shrinkx_charcoal -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: shrinkx_charcoal,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-shrinkx-charcoal',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if shrinkx_postpartum -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: shrinkx_postpartum,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-shrinkx-postpartum',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if shrinkx_postpartum_2pack -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: shrinkx_postpartum_2pack,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-shrinkx-postpartum-2pack',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if stomach_settle -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: stomach_settle,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-stomach-settle',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if milkflow_drink -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: milkflow_drink,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-milkflow-drink',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}

          {%- if milkflow_chews -%}
            {%- assign product_count = product_count | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                 card_product: milkflow_chews,
                 media_aspect_ratio: 'square',
                 show_secondary_image: false,
                 show_vendor: false,
                 show_rating: false,
                 show_quick_add: true,
                 section_id: 'usmama-milkflow-chews',
                 lazy_load: false
              %}
            </li>
          {%- endif -%}
        </ul>

        {%- comment -%}
          产品计数显示
        {%- endcomment -%}
        <div class="collection-product-count light">
          <p>{{ product_count }} products</p>
        </div>

      {%- else -%}
        {%- comment -%}
          没有找到产品时的提示信息
        {%- endcomment -%}
        <div class="collection collection--empty page-width">
          <div class="loading-overlay gradient"></div>
          <div class="title-wrapper center">
            <h2 class="title title--primary">
              Products not found
            </h2>
            <p class="collection-empty__subtext">
              The specified products are not available. Please check the product handles in the template.
            </p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    无访问权限时显示的默认内容
    当用户没有提供正确密钥时显示
  {%- endcomment -%}
  <div id="usmama-access-denied" style="display: block;">
    <div class="collection collection--empty page-width">
      <div class="title-wrapper center">
        <h2 class="title title--primary">
          Access Restricted
        </h2>
        <p class="collection-empty__subtext">
          This page requires special access. Please contact us if you need assistance.
        </p>
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  引入必要的JavaScript文件以支持快速加购等功能
{%- endcomment -%}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  访问控制脚本
  检查URL中的key参数，只有正确的密钥才能查看产品内容
{%- endcomment -%}
<script>
(function() {
  'use strict';
  
  // 配置访问密钥（可根据需要修改）
  const SECRET_KEY = 'xyz';
  
  // 获取URL中的key参数
  const urlParams = new URLSearchParams(window.location.search);
  const providedKey = urlParams.get('key');
  
  // 获取页面元素
  const contentDiv = document.getElementById('usmama-content');
  const accessDeniedDiv = document.getElementById('usmama-access-denied');
  
  // 验证访问密钥
  if (providedKey === SECRET_KEY) {
    // 密钥正确，显示产品内容
    if (contentDiv) {
      contentDiv.style.display = 'block';
    }
    if (accessDeniedDiv) {
      accessDeniedDiv.style.display = 'none';
    }
    
    // 可选：从URL中移除key参数，保护密钥不被轻易发现
    // if (window.history && window.history.replaceState) {
    //   const cleanUrl = window.location.pathname;
    //   window.history.replaceState({}, document.title, cleanUrl);
    // }
    
  } else {
    // 密钥错误或未提供，显示访问拒绝信息或重定向
    if (contentDiv) {
      contentDiv.style.display = 'none';
    }
    if (accessDeniedDiv) {
      accessDeniedDiv.style.display = 'block';
    }
    
    // 可选：重定向到404页面（取消注释以启用）
    // setTimeout(function() {
    //   window.location.href = '/404';
    // }, 2000);
  }
})();
</script>

