{% doc %}
  @prompt
    Create an image banner block similar to the existing one but modify the header styling so that when there are 2 words in the title, they display on the same line instead of breaking into separate lines. The block should maintain all other functionality of the current image banner while ensuring the header text stays on one line., this image banner needs to be a exact copy of the existing image banner block only difference is the heading.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.desktop_height }}px;
    overflow: hidden;
  }

  .ai-image-banner-{{ ai_gen_id }}__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-image-banner-{{ ai_gen_id }}__media img,
  .ai-image-banner-{{ ai_gen_id }}__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-banner-{{ ai_gen_id }}__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(18, 18, 18, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;}

  .ai-image-banner-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.2;
  }

  .ai-image-banner-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 2;
    text-align: {{ block.settings.desktop_content_alignment }};
    max-width: {{ block.settings.desktop_content_position | split: ' ' | first }}%;
    width: 100%;
    padding: 0 5rem;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--top-left {
    align-self: flex-start;justify-self: flex-start;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--top-center {
    align-self: flex-start;
    justify-self: center;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--top-right {
    align-self: flex-start;
    justify-self: flex-end;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--middle-left {
    align-self: center;
    justify-self: flex-start;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--middle-center {
    align-self: center;
    justify-self: center;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--middle-right {
    align-self: center;
    justify-self: flex-end;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--bottom-left {
    align-self: flex-end;
    justify-self: flex-start;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--bottom-center {
    align-self: flex-end;
    justify-self: center;
  }

  .ai-image-banner-{{ ai_gen_id }}__content--bottom-right {
    align-self: flex-end;
    justify-self: flex-end;
  }

  .ai-image-banner-{{ ai_gen_id }}__heading {
    margin: 0 0 1rem 0;
    color: {{ block.settings.text_color }};
    font-size: calc({{ settings.heading_scale }}px * {{ block.settings.heading_size }});
    line-height: calc(1 + 0.3 / max(1, {{ block.settings.heading_size }} * {{ settings.heading_scale }} / 100));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ai-image-banner-{{ ai_gen_id }}__text {
    margin: 0 0 2rem 0;
    color: {{ block.settings.text_color }};
    opacity: 0.75;
  }

  .ai-image-banner-{{ ai_gen_id }}__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: {{ block.settings.desktop_content_alignment }};
  }

  .ai-image-banner-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    padding: 1.2rem 3rem;
    text-decoration: none;
    border:0.1rem solid transparent;
    border-radius: var(--buttons-radius);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }

  .ai-image-banner-{{ ai_gen_id }}__button--primary {
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }

  .ai-image-banner-{{ ai_gen_id }}__button--primary:hover {
    background-color: rgba(var(--color-button), 0.85);
  }

  .ai-image-banner-{{ ai_gen_id }}__button--secondary {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border-color: currentColor;
  }

  .ai-image-banner-{{ ai_gen_id }}__button--secondary:hover {
    background-color: currentColor;
    color: rgb(var(--color-background));
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-image-banner-{{ ai_gen_id }}__content {
      text-align: {{ block.settings.mobile_content_alignment }};
      padding: 0 1.5rem;
    }

    .ai-image-banner-{{ ai_gen_id }}__heading {
      font-size: calc({{ settings.heading_scale }}px * {{ block.settings.heading_size }} * 0.8);
    }

    .ai-image-banner-{{ ai_gen_id }}__buttons {
      justify-content: {{ block.settings.mobile_content_alignment }};
    }

    .ai-image-banner-{{ ai_gen_id }}__button {
      min-height: 4rem;
      padding: 1rem 2.5rem;
      font-size: 1.3rem;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: 1fr;
      gap: 0;
    }

    .ai-image-banner-{{ ai_gen_id }}__media,
    .ai-image-banner-{{ ai_gen_id }}__placeholder {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .ai-image-banner-{{ ai_gen_id }}__content {
      grid-column: 1 / -1;
      grid-row: 1;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 0;
      align-content: center;
    }

    .ai-image-banner-{{ ai_gen_id }}__text-wrapper {
      grid-column: {{ block.settings.desktop_content_position | split: ' ' | last | split: '-' | first }} / span {{ block.settings.desktop_content_position | split: ' ' | first }};
    }
  }
{% endstyle %}<div class="ai-image-banner-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-{{ ai_gen_id }}__media">
    {% if block.settings.image != blank %}
      <img
        src="{{ block.settings.image | image_url: width: 3840 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}">
    {% else %}
      <div class="ai-image-banner-{{ ai_gen_id }}__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-image-banner-{{ ai_gen_id }}__content ai-image-banner-{{ ai_gen_id }}__content--{{ block.settings.desktop_content_position | split: ' ' | last }}">
    <div class="ai-image-banner-{{ ai_gen_id }}__text-wrapper">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-banner-{{ ai_gen_id }}__heading">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-image-banner-{{ ai_gen_id }}__text">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank %}
        <div class="ai-image-banner-{{ ai_gen_id }}__buttons">
          {% if block.settings.button_label_1 != blank %}
            <a
              href="{{ block.settings.button_link_1 }}"
              class="ai-image-banner-{{ ai_gen_id }}__button ai-image-banner-{{ ai_gen_id }}__button--primary"
            >
              {{ block.settings.button_label_1 }}
            </a>
          {% endif %}

          {% if block.settings.button_label_2 != blank %}
            <a
              href="{{ block.settings.button_link_2 }}"
              class="ai-image-banner-{{ ai_gen_id }}__button ai-image-banner-{{ ai_gen_id }}__button--secondary"
            >
              {{ block.settings.button_label_2 }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Image height",
      "info": "Adapt to image only works when an image is selected."
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Image banner",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "default": 1.0,
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Give customers details about the banner image(s) or content on the template.</p>",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "Button label",
      "label": "First button label",
      "info": "Leave the label blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "info": "Leave the label blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "41-4 top-left",
          "label": "Top-left"
        },
        {
          "value": "4 5-8 top-center",
          "label": "Top-center"
        },
        {
          "value": "4 9-12 top-right",
          "label": "Top-right"
        },
        {
          "value": "4 1-4 middle-left",
          "label": "Middle-left"
        },
        {
          "value": "4 5-8 middle-center",
          "label": "Middle-center"
        },
        {
          "value": "4 9-12 middle-right",
          "label": "Middle-right"
        },
        {
          "value": "4 1-4 bottom-left",
          "label": "Bottom-left"
        },
        {
          "value": "4 5-8 bottom-center",
          "label": "Bottom-center"
        },
        {
          "value": "4 9-12 bottom-right",
          "label": "Bottom-right"
        }
      ],
      "default": "4 5-8 middle-center",
      "label": "Desktop content position"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}